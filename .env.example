# ---- API ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres
DATABASE_URL=postgres://logs:logs@localhost:5432/logs

# Redis
REDIS_URL=redis://localhost:6379

# Ingesta
INGEST_SYNC=false          # true = esperar el flush a Postgres antes de responder (mas durable, mas lento)
MAX_BUFFER_ROWS=50000      # filas en el buffer de escritura antes de responder 503
WRITE_FLUSH_MS=200
WRITE_FLUSH_ROWS=500
PUBLISH_COALESCE_MS=50
PUBLISH_COALESCE_MAX=200
BULK_MAX_ITEMS=1000

# WebSocket gateway
WS_BATCH_MS=100
WS_MAX_BUFFERED_BYTES=1048576
WS_CLIENT_QUEUE_MAX=2000
WS_HEARTBEAT_MS=30000

# Retencion / particiones
RETENTION_DAYS=30
PARTITION_LOOKAHEAD_DAYS=7

# Exportacion
EXPORT_MAX_ROWS=1000000

# Autenticacion del dashboard (lecturas: logs, stats, alertas, export, WS).
# Vacio = modo local abierto, sin autenticacion (avisa por log en produccion).
# Generar uno: openssl rand -hex 32
DASHBOARD_TOKEN=

# CORS (dev only; en produccion nginx sirve todo desde un origen)
CORS_ORIGIN=http://localhost:5173

# ---- Web (Vite) ----
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
# Si el backend tiene DASHBOARD_TOKEN configurado, el navegador lo pide una
# vez y lo guarda en localStorage - no hace falta setearlo aca.

# ---- Loadgen ----
LOADGEN_TARGET_URL=http://localhost:4000
LOADGEN_API_KEY=
